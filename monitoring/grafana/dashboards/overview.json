{
  "title": "codegraph-mcp Overview",
  "uid": "cg-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Infrastructure",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host memory used",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{id=\"/\"}) / sum(machine_memory_bytes) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service health (all probes, 1 = up)",
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "displayMode": "list"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Probe latency (ms)",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "targets": [
        {
          "expr": "probe_duration_seconds * 1000",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU cores in use / total",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id=\"/\"}[1m])",
          "legendFormat": "in use"
        },
        {
          "expr": "machine_cpu_cores",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory per container",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_project=\"on-call-assistance\", name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU cores per container",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"on-call-assistance\", name!=\"\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Index & Builds",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Index freshness (hours behind HEAD)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "index_stale_hours"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hours",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Graph nodes",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 13
      },
      "targets": [
        {
          "expr": "graph_nodes_total"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Embedding throughput (chunks/min)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "expr": "rate(build_batches_total[5m]) * 60 * 64"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Build duration (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "targets": [
        {
          "expr": "build_duration_ms_sum / build_duration_ms_count",
          "legendFormat": "{{build_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "MCP Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "MCP tool calls/s",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "MCP tool latency p50/p95/p99 (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "semantic_search latency p50/p95 (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(semantic_search_latency_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(semantic_search_latency_ms_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Feedback & Decision Gate",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Feedback submissions (24h)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "increase(feedback_submissions_total[24h])"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Gate verdicts (24h)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (verdict) (increase(gate_verdicts_total[24h]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Decision-model gate latency (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gate_latency_ms_bucket[10m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gate_latency_ms_bucket[10m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Emails sent",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(emails_total[24h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Build History (from Postgres \u2014 includes builds predating metrics)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "collapsed": false
    },
    {
      "id": 41,
      "type": "table",
      "title": "All builds",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "pg-oncall"
          },
          "rawSql": "SELECT build_type, status, chunk_count, graph_nodes, graph_edges, CASE WHEN completed_at IS NULL THEN 'running' ELSE round(EXTRACT(EPOCH FROM (completed_at - created_at))::numeric, 0) || 's' END AS duration, weaviate_collection, neo4j_gen, created_at FROM build_registry ORDER BY created_at DESC LIMIT 25",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "collapsed": false
    },
    {
      "id": 51,
      "type": "logs",
      "title": "Errors & warnings (all services)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"oncall-.*\", level=~\"ERROR|WARNING\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 52,
      "type": "logs",
      "title": "Recent logs (all oncall containers)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"oncall-.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "row",
      "title": "Query cache",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 100
      },
      "panels": [],
      "id": 53
    },
    {
      "id": 54,
      "type": "timeseries",
      "title": "cache stored bytes / errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "query_cache_bytes_stored",
          "legendFormat": "bytes"
        },
        {
          "refId": "B",
          "expr": "rate(query_cache_errors_total[5m])",
          "legendFormat": "errors/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 101
      }
    },
    {
      "id": 55,
      "type": "timeseries",
      "title": "hits vs misses",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(query_cache_hits_total[5m])",
          "legendFormat": "hits/s"
        },
        {
          "refId": "B",
          "expr": "rate(query_cache_misses_total[5m])",
          "legendFormat": "misses/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 101
      }
    },
    {
      "id": 56,
      "type": "timeseries",
      "title": "index freshness (hours behind HEAD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "index_stale_hours",
          "legendFormat": "hours"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 101
      }
    },
    {
      "id": 57,
      "type": "row",
      "title": "User keys",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 109 }
    },
    {
      "id": 58,
      "type": "volkovlabs-form-panel",
      "title": "User keys — create / list / revoke (writes to Postgres)",
      "description": "One access key per person — per-user rate limits, usage attribution, and individual revocation. The shared MCP token keeps working for agents/scripts.\n\nHOW TO CREATE A KEY\n1. Paste the admin panel token (ADMIN_PANEL_TOKEN) into 'Admin token'. It is held in browser memory only and never saved to this dashboard (Save Default is disabled).\n2. Enter 'User name' and 'User email' (who the key belongs to — used in alerts and digests).\n3. Click 'Create key'.\n4. Copy the token from 'Result' IMMEDIATELY — it is shown once and only its SHA-256 hash is stored, so it can never be retrieved again.\n\nLIST: click 'List keys' to see every key id, status (active/REVOKED), owner, prefix, and last-used time.\n\nREVOKE: type the numeric 'Key id' from the list, then click 'Revoke key id'. That person loses access instantly; everyone else's key keeps working.\n\nUSING A KEY: send it as 'Authorization: Bearer <key>' on MCP (:8002/mcp) or REST (:8000/api). Wrong admin token → 401 (brute-force locked after repeated failures); empty name or bad email → 422.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 110 },
      "options": {
        "sync": false,
        "initial": { "method": "-", "url": "", "datasource": "", "header": [], "contentType": "application/json", "code": "return;", "highlight": false, "highlightColor": "red", "confirm": false, "payloadMode": "all", "getPayload": "return {};", "payload": {} },
        "updateEnabled": "disabled",
        "update": { "method": "-", "url": "", "datasource": "", "header": [], "contentType": "application/json", "code": "return;", "highlight": false, "highlightColor": "red", "confirm": false, "payloadMode": "all", "getPayload": "return {};", "payload": {} },
        "resetAction": { "mode": "custom", "code": "return;", "datasource": "", "getPayload": "return {};", "payload": {}, "confirm": false },
        "buttonGroup": { "orientation": "left", "size": "md" },
        "submit": { "variant": "hidden", "text": "Submit", "icon": "cloud-upload", "foregroundColor": "", "backgroundColor": "" },
        "reset": { "variant": "hidden", "text": "Reset", "icon": "process", "foregroundColor": "", "backgroundColor": "" },
        "saveDefault": { "variant": "hidden", "text": "Save Default", "icon": "save" },
        "elements": [
          { "uid": "uk_admin_key", "id": "admin_key", "title": "Admin token", "type": "password", "labelWidth": 30, "width": null, "tooltip": "ADMIN_PANEL_TOKEN — typed at runtime, never saved into the dashboard JSON", "section": "", "unit": "", "hidden": false, "value": "" },
          {
            "uid": "uk_btn_eye", "id": "btn_eye", "title": "", "type": "button", "labelWidth": 10, "width": null, "tooltip": "Toggle admin token visibility", "section": "", "unit": "", "hidden": false,
            "customCode": "try { const els = (context.panel && context.panel.elements) || []; const cur = els.find(function (e) { return e.id === 'admin_key'; }); if (!cur) { return; } const nextType = (cur.type === 'password') ? 'string' : 'password'; if (context.panel.onChangeElements) { context.panel.onChangeElements(els.map(function (e) { if (e.id !== 'admin_key') { return e; } return Object.assign({}, e, { type: nextType, hidden: false }); })); } } catch (err) { if (context.grafana && context.grafana.notifyError) { context.grafana.notifyError(['Show token', String(err)]); } }",
            "size": "sm", "show": "form", "variant": "secondary", "foregroundColor": "", "backgroundColor": "", "buttonLabel": "Show/hide token"
          },
          { "uid": "uk_user_name", "id": "user_name", "title": "User name", "type": "string", "labelWidth": 30, "width": null, "tooltip": "Who this key belongs to (used in alerts and usage attribution)", "section": "", "unit": "", "hidden": false, "value": "" },
          { "uid": "uk_user_email", "id": "user_email", "title": "User email", "type": "string", "labelWidth": 30, "width": null, "tooltip": "Contact for revocation and digests", "section": "", "unit": "", "hidden": false, "value": "" },
          { "uid": "uk_key_id", "id": "key_id", "title": "Key id", "type": "number", "labelWidth": 30, "width": null, "tooltip": "Numeric id shown by List keys — used by Revoke", "section": "", "unit": "", "hidden": false, "min": 1, "value": null },
          { "uid": "uk_result", "id": "result", "title": "Result", "type": "disabledTextarea", "labelWidth": 30, "width": null, "tooltip": "New tokens appear here once — copy them immediately", "section": "", "unit": "", "hidden": false, "rows": 6, "value": "" },
          {
            "uid": "uk_btn_create", "id": "btn_create", "title": "", "type": "button", "labelWidth": 10, "width": null, "tooltip": "", "section": "", "unit": "", "hidden": false,
            "customCode": "try { const bases = []; if (typeof window !== 'undefined' && window.location && window.location.hostname) { bases.push('http://' + window.location.hostname + ':8000'); } bases.push('http://localhost:8000'); const tryFetch = function (path, opts) { let i = 0; const attempt = function () { if (i >= bases.length) { return Promise.reject(new Error('all API endpoints failed: ' + bases.join(' , '))); } return fetch(bases[i++] + path, opts).catch(attempt); }; return attempt(); }; const v = {}; ((context.panel && context.panel.elements) || []).forEach(function (e) { v[e.id] = e.value; }); const key = String(v.admin_key || '').trim(); const name = String(v.user_name || '').trim(); const email = String(v.user_email || '').trim(); if (!key || !name || !email) { context.grafana.notifyError(['Create key', 'admin token, user name and user email are all required']); return; } return tryFetch('/api/admin/users?user_name=' + encodeURIComponent(name) + '&user_email=' + encodeURIComponent(email), { method: 'POST', headers: { Authorization: 'Bearer ' + key } }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (body) { if (!r.ok) { context.grafana.notifyError(['Create key', 'HTTP ' + r.status + ': ' + (body.detail || 'failed')]); return; } context.panel.patchFormValue({ result: 'id ' + body.id + '  prefix ' + body.token_prefix + '  ' + body.user_name + ' <' + body.user_email + '>  TOKEN ' + body.token + '  (store now, not retrievable later)' }); context.grafana.notifySuccess(['Create key', 'key created — copy the token from the Result box now']); }); }).catch(function (e) { context.grafana.notifyError(['Create key', 'Cannot reach :8000 (network/CORS): ' + String(e)]); }); } catch (err) { context.grafana.notifyError(['Create key', String(err)]); }",
            "size": "md", "show": "form", "variant": "primary", "foregroundColor": "", "backgroundColor": "", "buttonLabel": "Create key"
          },
