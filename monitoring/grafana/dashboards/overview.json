{
  "title": "codegraph-mcp Overview",
  "uid": "cg-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Infrastructure",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host memory used",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{id=\"/\"}) / sum(machine_memory_bytes) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service health (all probes, 1 = up)",
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "displayMode": "list"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Probe latency (ms)",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "targets": [
        {
          "expr": "probe_duration_seconds * 1000",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU cores in use / total",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id=\"/\"}[1m])",
          "legendFormat": "in use"
        },
        {
          "expr": "machine_cpu_cores",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory per container",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_project=\"on-call-assistance\", name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU cores per container",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"on-call-assistance\", name!=\"\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Index & Builds",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Index freshness (hours behind HEAD)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "index_stale_hours"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hours",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Graph nodes",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 13
      },
      "targets": [
        {
          "expr": "graph_nodes_total"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Embedding throughput (chunks/min)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "expr": "rate(build_batches_total[5m]) * 60 * 64"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Build duration (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "targets": [
        {
          "expr": "build_duration_ms_sum / build_duration_ms_count",
          "legendFormat": "{{build_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "MCP Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "MCP tool calls/s",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "MCP tool latency p50/p95/p99 (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "semantic_search latency p50/p95 (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(semantic_search_latency_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(semantic_search_latency_ms_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Feedback & Decision Gate",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Feedback submissions (24h)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "increase(feedback_submissions_total[24h])"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Gate verdicts (24h)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (verdict) (increase(gate_verdicts_total[24h]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Decision-model gate latency (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gate_latency_ms_bucket[10m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gate_latency_ms_bucket[10m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Emails sent",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(emails_total[24h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Build History (from Postgres \u2014 includes builds predating metrics)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "collapsed": false
    },
    {
      "id": 41,
      "type": "table",
      "title": "All builds",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "pg-oncall"
          },
          "rawSql": "SELECT build_type, status, chunk_count, graph_nodes, graph_edges, CASE WHEN completed_at IS NULL THEN 'running' ELSE round(EXTRACT(EPOCH FROM (completed_at - created_at))::numeric, 0) || 's' END AS duration, weaviate_collection, neo4j_gen, created_at FROM build_registry ORDER BY created_at DESC LIMIT 25",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "collapsed": false
    },
    {
      "id": 51,
      "type": "logs",
      "title": "Errors & warnings (all services)",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{container=~\"oncall-.*\", level=~\"ERROR|WARNING\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 52,
      "type": "logs",
      "title": "Recent logs (all oncall containers)",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{container=~\"oncall-.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}