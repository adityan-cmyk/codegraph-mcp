{
  "title": "codegraph-mcp Overview",
  "uid": "cg-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Infrastructure",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host memory used",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{id=\"/\"}) / sum(machine_memory_bytes) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Host CPU cores in use",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id=\"/\"}[1m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory per container",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_project=\"on-call-assistance\", name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU cores per container",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"on-call-assistance\", name!=\"\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Index & Builds",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Index freshness (hours behind HEAD)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "index_stale_hours"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hours",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Graph nodes",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 7
      },
      "targets": [
        {
          "expr": "graph_nodes_total"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Embedding throughput (chunks/min)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "expr": "rate(build_batches_total[5m]) * 60 * 64"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Build duration (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "expr": "build_duration_ms_sum / build_duration_ms_count",
          "legendFormat": "{{build_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "MCP Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "MCP tool calls/s",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "MCP tool latency p50/p95/p99 (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "semantic_search latency p50/p95 (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(semantic_search_latency_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(semantic_search_latency_ms_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Feedback & Decision Gate",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Feedback submissions (24h)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "increase(feedback_submissions_total[24h])"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Gate verdicts (24h)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (verdict) (increase(gate_verdicts_total[24h]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Decision-model gate latency (ms)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gate_latency_ms_bucket[10m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gate_latency_ms_bucket[10m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Emails sent",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(emails_total[24h]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}