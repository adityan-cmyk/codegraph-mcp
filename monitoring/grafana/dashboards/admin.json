{
  "title": "codegraph-admin",
  "uid": "cg-admin",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "backend up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"backend\"})"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "tool calls / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total[5m])) * 60"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total{status=\"error\"}[5m])) / clamp_min(sum(rate(mcp_tool_calls_total[5m])), 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 1
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(query_cache_hits_total[10m])) / clamp_min(sum(rate(query_cache_hits_total[10m])) + sum(rate(query_cache_misses_total[10m])), 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Tool usage (uam_audit)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "calls over time by tool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m])) * 60",
          "legendFormat": "{{tool}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "calls by user (allowed / denied)",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT user_name AS \"user\", count(*) FILTER (WHERE allowed) AS allowed, count(*) FILTER (WHERE NOT allowed) AS denied FROM uam_audit WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 50"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "audited calls over time",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '5m'), count(*) AS calls, count(*) FILTER (WHERE NOT allowed) AS denied FROM uam_audit WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "top tools",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT action AS tool, count(*) AS calls, count(*) FILTER (WHERE NOT allowed) AS denied FROM uam_audit WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 50"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "recent denials",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT created_at AS \"at\", user_name AS \"user\", action AS tool, reason FROM uam_audit WHERE NOT allowed AND $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 25"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 19,
        "y": 14
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Cache",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "cache stored bytes / errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "query_cache_bytes_stored",
          "legendFormat": "bytes"
        },
        {
          "refId": "B",
          "expr": "rate(query_cache_errors_total[5m])",
          "legendFormat": "errors/s"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "hits vs misses",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(query_cache_hits_total[5m])",
          "legendFormat": "hits/s"
        },
        {
          "refId": "B",
          "expr": "rate(query_cache_misses_total[5m])",
          "legendFormat": "misses/s"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 22
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "index freshness (hours behind HEAD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "index_stale_hours",
          "legendFormat": "hours"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 22
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "id": 31,
      "type": "logs",
      "title": "oncall-backend",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"oncall-backend\"}",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Controls (admin token required \u2014 stored in your browser only)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      }
    },
    {
      "id": 41,
      "type": "text",
      "title": "control card",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "options": {
        "mode": "html",
        "content": "<div id=\"cg-admin-card\">\n<style>\n  #cg-admin-card {\n    --bg: #111217;\n    --panel: #181b1f;\n    --border: #2c3235;\n    --border-focus: #41474d;\n    --text: #ccccdc;\n    --muted: #8e9297;\n    --accent: #5794f2;\n    --accent-hover: #6ca0f5;\n    --success: #73bf69;\n    --danger: #f2495c;\n    font-family: -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    font-size: 13px;\n    color: var(--text);\n    background: var(--bg);\n    padding: 14px;\n    border-radius: 4px;\n  }\n  #cg-admin-card * { box-sizing: border-box; }\n  #cg-admin-card .cg-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));\n    gap: 12px;\n  }\n  #cg-admin-card fieldset {\n    border: 1px solid var(--border);\n    border-radius: 4px;\n    background: var(--panel);\n    margin: 0 0 12px 0;\n    padding: 12px 14px 14px;\n  }\n  #cg-admin-card legend {\n    padding: 0 8px;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: var(--accent);\n  }\n  #cg-admin-card label { display: block; color: var(--muted); font-size: 11px; margin: 8px 0 3px; }\n  #cg-admin-card input, #cg-admin-card select {\n    width: 100%;\n    background: var(--bg);\n    color: var(--text);\n    border: 1px solid var(--border);\n    border-radius: 3px;\n    padding: 6px 8px;\n    font-size: 13px;\n    font-family: ui-monospace, monospace;\n    outline: none;\n  }\n  #cg-admin-card input:focus, #cg-admin-card select:focus { border-color: var(--border-focus); }\n  #cg-admin-card button {\n    background: var(--border);\n    color: var(--text);\n    border: 1px solid var(--border);\n    border-radius: 3px;\n    padding: 6px 14px;\n    font-size: 12px;\n    cursor: pointer;\n    margin: 8px 6px 0 0;\n    transition: background 0.15s;\n  }\n  #cg-admin-card button:hover { background: var(--border-focus); }\n  #cg-admin-card button.primary { background: var(--accent); border-color: var(--accent); color: #0b0c0e; font-weight: 600; }\n  #cg-admin-card button.primary:hover { background: var(--accent-hover); }\n  #cg-admin-card button.danger { color: var(--danger); border-color: #5a2c33; }\n  #cg-admin-card button.danger:hover { background: #3a2226; }\n  #cg-admin-card .cg-row { display: flex; gap: 8px; }\n  #cg-admin-card .cg-row > * { flex: 1; }\n  #cg-admin-card .cg-status {\n    margin-top: 10px;\n    padding: 8px 10px;\n    border-radius: 3px;\n    font-family: ui-monospace, monospace;\n    font-size: 12px;\n    display: none;\n  }\n  #cg-admin-card .cg-status.ok { display: block; background: rgba(115,191,105,0.08); border: 1px solid rgba(115,191,105,0.3); color: var(--success); }\n  #cg-admin-card .cg-status.err { display: block; background: rgba(242,73,92,0.08); border: 1px solid rgba(242,73,92,0.3); color: var(--danger); }\n  #cg-admin-card .cg-status.info { display: block; background: rgba(87,148,242,0.08); border: 1px solid rgba(87,148,242,0.3); color: var(--accent); }\n  #cg-admin-card .cg-key-banner {\n    display: none;\n    margin-top: 10px;\n    padding: 10px;\n    border: 1px dashed var(--accent);\n    border-radius: 3px;\n    background: rgba(87,148,242,0.06);\n  }\n  #cg-admin-card .cg-key-banner .key {\n    font-family: ui-monospace, monospace;\n    font-size: 12px;\n    color: var(--accent);\n    word-break: break-all;\n    margin: 6px 0;\n  }\n  #cg-admin-card .cg-conn-state { margin-left: 10px; color: var(--muted); font-size: 11px; }\n  #cg-admin-card details.cg-out {\n    border: 1px solid var(--border);\n    border-radius: 3px;\n    background: var(--panel);\n    margin-top: 12px;\n  }\n  #cg-admin-card details.cg-out summary {\n    cursor: pointer;\n    padding: 8px 14px;\n    color: var(--muted);\n    font-size: 11px;\n    letter-spacing: 0.04em;\n  }\n  #cg-admin-card pre {\n    margin: 0;\n    padding: 12px 14px;\n    border-top: 1px solid var(--border);\n    max-height: 340px;\n    overflow: auto;\n    font-size: 12px;\n    line-height: 1.5;\n    color: var(--text);\n    white-space: pre-wrap;\n  }\n</style>\n\n<fieldset>\n  <legend>connection</legend>\n  <div class=\"cg-row\">\n    <div>\n      <label>API base</label>\n      <input id=\"cg-api\" placeholder=\"http://myhost:8000\">\n    </div>\n    <div>\n      <label>admin token</label>\n      <input id=\"cg-token\" type=\"password\" placeholder=\"ADMIN_PANEL_TOKEN\">\n    </div>\n  </div>\n  <button class=\"primary\" onclick=\"cgSaveConn()\">save connection</button>\n  <span class=\"cg-conn-state\" id=\"cg-conn-state\"></span>\n  <div class=\"cg-status\" id=\"cg-conn-msg\"></div>\n</fieldset>\n\n<div class=\"cg-grid\">\n  <fieldset>\n    <legend>rate limit</legend>\n    <div class=\"cg-row\">\n      <div>\n        <label>burst capacity</label>\n        <input id=\"cg-cap\" type=\"number\" value=\"60\" min=\"1\" max=\"1000\">\n      </div>\n      <div>\n        <label>refill / sec</label>\n        <input id=\"cg-refill\" type=\"number\" step=\"0.1\" value=\"1\" min=\"0.1\" max=\"50\">\n      </div>\n    </div>\n    <button onclick=\"cgGetRate()\">show current</button>\n    <button class=\"primary\" onclick=\"cgSetRate()\">apply</button>\n    <div class=\"cg-status\" id=\"cg-rate-msg\"></div>\n  </fieldset>\n\n  <fieldset>\n    <legend>cache</legend>\n    <button onclick=\"cgCacheStats()\">stats</button>\n    <button class=\"danger\" onclick=\"cgFlush('')\">flush all</button>\n    <div class=\"cg-row\" style=\"margin-top: 8px\">\n      <div>\n        <label>invalidate tag</label>\n        <select id=\"cg-tag\">\n          <option value=\"graph\">graph</option>\n          <option value=\"git\">git</option>\n          <option value=\"tests\">tests</option>\n        </select>\n      </div>\n    </div>\n    <button onclick=\"cgFlush(document.getElementById('cg-tag').value)\">invalidate tag</button>\n    <div class=\"cg-status\" id=\"cg-cache-msg\"></div>\n  </fieldset>\n\n  <fieldset>\n    <legend>users</legend>\n    <div class=\"cg-row\">\n      <div>\n        <label>name</label>\n        <input id=\"cg-uname\" placeholder=\"jane\">\n      </div>\n      <div>\n        <label>tier</label>\n        <select id=\"cg-utier\">\n          <option>free</option>\n          <option>pro</option>\n          <option>enterprise</option>\n        </select>\n      </div>\n    </div>\n    <label>roles (comma-separated: viewer, reviewer, operator, admin)</label>\n    <input id=\"cg-uroles\" value=\"viewer\">\n    <button class=\"primary\" onclick=\"cgCreateUser()\">create user</button>\n    <button onclick=\"cgListUsers()\">list users</button>\n    <div class=\"cg-key-banner\" id=\"cg-key-banner\">\n      <label style=\"margin-top:0\">new API key \u2014 shown once, store it now</label>\n      <div class=\"key\" id=\"cg-key-value\"></div>\n      <button onclick=\"cgCopyKey()\">copy</button>\n    </div>\n    <div class=\"cg-status\" id=\"cg-user-msg\"></div>\n  </fieldset>\n\n  <fieldset>\n    <legend>usage</legend>\n    <button onclick=\"cgUsage()\">last 7 days</button>\n    <div class=\"cg-status\" id=\"cg-usage-msg\"></div>\n  </fieldset>\n</div>\n\n<details class=\"cg-out\">\n  <summary>raw responses</summary>\n  <pre id=\"cg-out\">\u2014</pre>\n</details>\n</div>\n\n<script>\n(function() {\n  var $ = function(id) { return document.getElementById(id); };\n  $('cg-api').value = localStorage.getItem('cg_api') || 'http://myhost:8000';\n  $('cg-token').value = localStorage.getItem('cg_token') || '';\n\n  function flash(id, cls, text) {\n    var el = $(id);\n    el.className = 'cg-status ' + cls;\n    el.textContent = text;\n  }\n\n  window.cgSaveConn = function() {\n    localStorage.setItem('cg_api', $('cg-api').value.replace(/\\/$/, ''));\n    localStorage.setItem('cg_token', $('cg-token').value);\n    $('cg-conn-state').textContent = 'saved in this browser only';\n    flash('cg-conn-msg', 'ok', 'connection saved \u2014 token lives in this browser\\'s localStorage, nowhere else');\n  };\n\n  function api(method, path, statusId, successText) {\n    var base = localStorage.getItem('cg_api') || 'http://myhost:8000';\n    var tok = localStorage.getItem('cg_token') || '';\n    if (!tok) {\n      flash(statusId || 'cg-conn-msg', 'err', 'no admin token \u2014 set it in the connection box first');\n      return;\n    }\n    flash(statusId, 'info', 'working\\u2026');\n    fetch(base + path, {\n      method: method,\n      headers: { 'Authorization': 'Bearer ' + tok, 'Content-Type': 'application/json' }\n    })\n      .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, j: j }; }); })\n      .then(function(x) {\n        $('cg-out').textContent = JSON.stringify(x.j, null, 2);\n        if (x.ok) {\n          flash(statusId, 'ok', successText || 'done');\n          if (x.j && x.j.api_key) {\n            $('cg-key-value').textContent = x.j.api_key;\n            $('cg-key-banner').style.display = 'block';\n          }\n        } else {\n          var detail = (x.j && (x.j.detail || x.j.reason)) || 'request failed';\n          flash(statusId, 'err', typeof detail === 'string' ? detail : JSON.stringify(detail));\n        }\n      })\n      .catch(function(e) {\n        flash(statusId, 'err', 'request failed: ' + e.message + ' \u2014 check API base and that the backend is reachable');\n      });\n  }\n\n  window.cgGetRate = function() { api('GET', '/api/admin/rate-limit', 'cg-rate-msg'); };\n  window.cgSetRate = function() {\n    api('PUT', '/api/admin/rate-limit?capacity=' + encodeURIComponent($('cg-cap').value) +\n        '&refill_per_sec=' + encodeURIComponent($('cg-refill').value),\n        'cg-rate-msg', 'rate limit updated \u2014 applies within ~30s');\n  };\n  window.cgCacheStats = function() { api('GET', '/api/admin/cache', 'cg-cache-msg'); };\n  window.cgFlush = function(tag) {\n    api('POST', '/api/admin/cache/flush' + (tag ? '?tag=' + tag : ''), 'cg-cache-msg', 'cache flushed');\n  };\n  window.cgCreateUser = function() {\n    $('cg-key-banner').style.display = 'none';\n    api('POST', '/api/uam/users?name=' + encodeURIComponent($('cg-uname').value) +\n        '&tier=' + $('cg-utier').value + '&roles=' + encodeURIComponent($('cg-uroles').value),\n        'cg-user-msg', 'user created \u2014 copy the key below');\n  };\n  window.cgListUsers = function() { api('GET', '/api/uam/users', 'cg-user-msg'); };\n  window.cgUsage = function() { api('GET', '/api/admin/usage?days=7', 'cg-usage-msg'); };\n  window.cgCopyKey = function() {\n    var text = $('cg-key-value').textContent;\n    if (navigator.clipboard) {\n      navigator.clipboard.writeText(text).then(function() { flash('cg-user-msg', 'ok', 'key copied'); });\n    }\n  };\n})();\n</script>\n"
      }
    },
    {
      "id": 32,
      "type": "logs",
      "title": "oncall-backend \u2014 errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"oncall-backend\"} |~ \"\\\"level\\\":\\\"(ERROR|WARNING)\\\"\"",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      }
    }
  ]
}