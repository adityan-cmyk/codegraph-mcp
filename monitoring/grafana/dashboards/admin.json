{
  "title": "codegraph-admin",
  "uid": "cg-admin",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "backend up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"backend\"})"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "tool calls / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total[5m])) * 60"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_tool_latency_ms_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total{status=\"error\"}[5m])) / clamp_min(sum(rate(mcp_tool_calls_total[5m])), 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 1
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "cache hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(query_cache_hits_total[10m])) / clamp_min(sum(rate(query_cache_hits_total[10m])) + sum(rate(query_cache_misses_total[10m])), 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Tool usage (uam_audit)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "calls over time by tool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(mcp_tool_calls_total[5m])) * 60",
          "legendFormat": "{{tool}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "calls by user (allowed / denied)",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT user_name AS \"user\", count(*) FILTER (WHERE allowed) AS allowed, count(*) FILTER (WHERE NOT allowed) AS denied FROM uam_audit WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 50"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "audited calls over time",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '5m'), count(*) AS calls, count(*) FILTER (WHERE NOT allowed) AS denied FROM uam_audit WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "top tools",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT action AS tool, count(*) AS calls, count(*) FILTER (WHERE NOT allowed) AS denied FROM uam_audit WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 50"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "recent denials",
      "datasource": {
        "type": "postgres",
        "uid": "pg-oncall"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT created_at AS \"at\", user_name AS \"user\", action AS tool, reason FROM uam_audit WHERE NOT allowed AND $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 25"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 19,
        "y": 14
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Cache",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "cache stored bytes / errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "query_cache_bytes_stored",
          "legendFormat": "bytes"
        },
        {
          "refId": "B",
          "expr": "rate(query_cache_errors_total[5m])",
          "legendFormat": "errors/s"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "hits vs misses",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(query_cache_hits_total[5m])",
          "legendFormat": "hits/s"
        },
        {
          "refId": "B",
          "expr": "rate(query_cache_misses_total[5m])",
          "legendFormat": "misses/s"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 22
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "index freshness (hours behind HEAD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "index_stale_hours",
          "legendFormat": "hours"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 22
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "id": 31,
      "type": "logs",
      "title": "oncall-backend",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"oncall-backend\"}",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Controls (admin token required \u2014 stored in your browser only)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      }
    },
    {
      "id": 41,
      "type": "text",
      "title": "control card",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "options": {
        "mode": "markdown",
        "content": "## Admin controls moved\n\nThe control card now lives on its own origin (backend-served, no Grafana HTML exceptions):\n\n**http://myhost:8000/admin**\n\nGrafana HTML sanitization has been re-enabled; this dashboard is read-only panels."
      }
    },
    {
      "id": 32,
      "type": "logs",
      "title": "oncall-backend \u2014 errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"oncall-backend\"} |~ \"\\\"level\\\":\\\"(ERROR|WARNING)\\\"\"",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      }
    }
  ]
}