# Environment
ENVIRONMENT=production

# Codebase to index
CODEBASE_REPO_PATH=/path/to/your/codebase
CODEBASE_GIT_BRANCH=master
CODEBASE_GIT_REMOTE=git.example.com

# Network — your server's IP and allowed client IPs
HOST_IP=0.0.0.0
TRUSTED_HOSTS=["backend","localhost","127.0.0.1"]
CORS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Storage backends
INDEX_METADATA_BACKEND=postgres
SEMANTIC_INDEX_BACKEND=weaviate
GRAPH_INDEX_BACKEND=neo4j

# Database
POSTGRES_DSN=postgresql://oncall:oncall@postgres:5432/oncall
REDIS_URL=redis://redis:6379/0

# Weaviate
WEAVIATE_URL=http://weaviate:8080

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Auth — MCP server bearer token (leave empty to disable auth)
MCP_AUTH_TOKEN=your-secret-token-here

# SMTP notifications (leave empty to disable — Gmail needs an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=[]
SMTP_USE_TLS=true

# Indexing
INDEX_REPLAY_ON_STARTUP=false
